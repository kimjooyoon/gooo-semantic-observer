activity id="gooo://semantic-observer/activity/append-refuted-transition" activity="AppendRefutedTransition" name="Append refuted transition" proof="COHERENCE" indicator="DRIVER" metric_id="gooo.metric.semantic-observer.refuted-transition.v1" metric_path="transitions.refuted" artifact="transitions.ndjson" evaluator="observer.Observe"
activity id="gooo://semantic-observer/activity/preserve-unknown-record" activity="PreserveUnknownRecord" name="Preserve six-field unknown record" proof="COHERENCE" indicator="OUTCOME" metric_id="gooo.metric.semantic-observer.unknown-record.v1" metric_path="observer-receipt.unknowns" artifact="observer-receipt.json" evaluator="observer.Observe"

activity id="gooo://semantic-observer/activity/enforce-digest-match" activity="EnforceDigestMatch" name="Enforce evaluator and evidence digest match" proof="REGRESSION" indicator="GUARDRAIL" metric_id="gooo.metric.semantic-observer.digest-match.v1" metric_path="evidence.digest" artifact="observer-receipt.json" evaluator="observer.Observe"
