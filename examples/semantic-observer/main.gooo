@gooo schema="gooo/semantic-observer/v1"
project id="gooo://project/semantic-observer" name="Semantic observer"

activity id="gooo://semantic-observer/activity/observe-immutable-run" activity="ObserveImmutableRun" name="Observe immutable GitHub run" proof="FOUNDATION" indicator="DRIVER" metric_id="gooo.metric.semantic-observer.immutable-run.v1" metric_path="evidence.immutable-run" artifact="evidence.ndjson" evaluator="observer.Observe"
activity id="gooo://semantic-observer/activity/observe-immutable-artifact" activity="ObserveImmutableArtifact" name="Observe immutable GitHub artifact" proof="FOUNDATION" indicator="OUTCOME" metric_id="gooo.metric.semantic-observer.immutable-artifact.v1" metric_path="evidence.immutable-artifact" artifact="evidence.ndjson" evaluator="observer.Observe"
activity id="gooo://semantic-observer/activity/observe-immutable-commit" activity="ObserveImmutableCommit" name="Observe immutable Git commit" proof="FOUNDATION" indicator="GUARDRAIL" metric_id="gooo.metric.semantic-observer.immutable-commit.v1" metric_path="evidence.immutable-commit" artifact="evidence.ndjson" evaluator="observer.Observe"
activity id="gooo://semantic-observer/activity/bind-claim-exact-tuple" activity="BindClaimExactTuple" name="Bind claim exact tuple" proof="FOUNDATION" indicator="DRIVER" metric_id="gooo.metric.semantic-observer.claim-exact-tuple.v1" metric_path="claims.exact-tuple" artifact="claims.ndjson" evaluator="observer.Observe"

activity id="gooo://semantic-observer/activity/preserve-original-claim" activity="PreserveOriginalClaim" name="Preserve original claim" proof="COHERENCE" indicator="OUTCOME" metric_id="gooo.metric.semantic-observer.original-claim.v1" metric_path="claims.original" artifact="claims.ndjson" evaluator="observer.Observe"
